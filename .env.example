# Copy to the path shown by `mixcloud-mcp-server --print-config` and fill in.
# Never commit the real file: it holds a live access token.

# OAuth app credentials from https://www.mixcloud.com/settings/applications/
MIXCLOUD_CLIENT_ID=
MIXCLOUD_CLIENT_SECRET=

# Access token. Normally written for you by the exchange_code tool.
MIXCLOUD_TOKEN=

# Where the token is persisted and where it is read from at startup.
# MIXCLOUD_ENV_FILE=~/.config/mixcloud-mcp-server/.env

# The only directory uploads may read files from.
# MIXCLOUD_UPLOAD_DIR=~/.local/share/mixcloud-mcp-server/uploads